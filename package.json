    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
